{
    "private" : false,
    "nps"     : 744397,
    "source"  : "https://github.com/nodchip/tanuki-",

    "build" : {
        "path"      : "source",
        "compilers" : ["clang++"],
        "cpuflags"  : ["AVX2"],
        "systems"   : ["Linux", "Windows", "Darwin"],
        "command"   : {
            "jobs"      : 64,
            "target"    : "normal",
            "arguments" : [
                "YANEURAOU_EDITION=YANEURAOU_ENGINE_NNUE_SFNNwoP1536",
                "TARGET_CPU=AVX2",
                "COMPILER=clang++",
                "EVAL_EMBEDDING=OFF"
            ]
        },
        "network" : {
            "mode"     : "external_directory",
            "option"   : "EvalDir",
            "filename" : "nn.bin"
        }
    },

    "test_presets" : {
        "default" : {
            "base_branch"     : "main",
